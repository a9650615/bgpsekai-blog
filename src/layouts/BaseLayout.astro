---
// BaseLayout — site-wide HTML shell.
//
// Per spec (`url-and-integrations`):
//   * Always inject AdSense `ca-pub-9488921689181013` in <head>.
//   * GA4 conditional on `PUBLIC_GA4_MEASUREMENT_ID` (build does not fail when
//     unset; §9.3 will tighten this once the ID is provisioned).
//   * Never inject GA Universal `UA-51767762-4`, `<amp-*>`, or
//     `cdn.ampproject.org`.
//   * Cloudflare Web Analytics is Phase 2 — not injected here.
//   * Pagefind UI css comes via the <Search/> island that owns it; we don't
//     duplicate the link here.
//
// Per `blog-rendering` "Casper-ish layout fidelity": header on every route
// shows site title + nav, footer carries copyright + RSS link.
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url as baseUrl } from '../utils/url.ts';
import { SITE_NAME, documentTitle, metaDescription } from '../utils/seo.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  featureImage?: ImageMetadata | string;
  ogType?: 'website' | 'article';
  publishDate?: Date;
  /** Post author — drives the BlogPosting JSON-LD. Articles only. */
  author?: string;
  /** Post updatedDate — omitted from JSON-LD when absent. Articles only. */
  modifiedDate?: Date;
  /** Tag display names — article:tag + JSON-LD keywords. Articles only. */
  tagNames?: string[];
  /**
   * Trail from the home page down to this page (home itself is implied).
   * Drives the BreadcrumbList JSON-LD, which is what search results show in
   * place of the raw URL.
   */
  breadcrumbs?: Array<{ name: string; path: string }>;
  /** Keep the page out of search results (thin lists, 404). Links still count. */
  noindex?: boolean;
  /** schema.org type for non-article pages, e.g. CollectionPage, ProfilePage. */
  pageType?: string;
}

const {
  title,
  description: rawDescription,
  canonicalPath,
  featureImage,
  ogType = 'website',
  publishDate,
  author,
  modifiedDate,
  tagNames = [],
  breadcrumbs = [],
  noindex = false,
  pageType,
} = Astro.props;

// `title` stays the bare page name for share cards (og:site_name already
// carries the brand); the <title> element gets the site name appended.
const fullTitle = documentTitle(title);
const description = metaDescription(rawDescription);

// `Astro.site` is the bare origin (no base), and `Astro.url.pathname` already
// includes the base — so when we have a `canonicalPath` from a caller (which
// is base-less, e.g. `/about-me/`), we must run it through `baseUrl()` to
// prepend the deploy base before stitching to the origin. Falling back to
// `Astro.url.pathname` keeps it correct when no canonicalPath is supplied
// (since pathname already has the base baked in).
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? 'https://blog.bgpsekai.club';
const pathWithBase = canonicalPath != null ? baseUrl(canonicalPath) : Astro.url.pathname;
const canonicalUrl = `${siteOrigin}${pathWithBase}`;

function resolveOgImage(img: ImageMetadata | string | undefined): string | undefined {
  if (!img) return undefined;
  if (typeof img === 'string') {
    // String src: treat as already-absolute, OR a site-relative path that
    // needs the base prepended via baseUrl().
    if (img.startsWith('http')) return img;
    return `${siteOrigin}${baseUrl(img)}`;
  }
  // ImageMetadata: `src` is a Vite-emitted build-time path that ALREADY
  // includes the base (Vite reads it from `import.meta.env.BASE_URL`).
  return `${siteOrigin}${img.src}`;
}
const ogImage = resolveOgImage(featureImage);
// Share-card fallback: pages without their own cover (home, tag/author lists,
// coverless posts) still need an og:image or link previews render blank. The
// portal's 1200x630 card is the brand default. JSON-LD keeps using `ogImage`
// only, so articles never claim the generic card as their own image.
const DEFAULT_OG_IMAGE = 'https://bgpsekai.club/og-default.png';
const shareImage = ogImage ?? DEFAULT_OG_IMAGE;

// JSON-LD. The site had none before 2026-09-26; this does not affect whether a
// page gets indexed, it feeds the rich result (date/author/breadcrumb) Google
// renders under the title. `@graph` keeps WebSite + BlogPosting in one block.
const siteName = SITE_NAME;
const abs = (path: string) => `${siteOrigin}${baseUrl(path)}`;
const publisher = {
  '@type': 'Organization',
  '@id': `${siteOrigin}/#publisher`,
  name: siteName,
  url: `${siteOrigin}/`,
  logo: { '@type': 'ImageObject', url: abs('/favicon-192.png'), width: 192, height: 192 },
  sameAs: ['https://bgpsekai.club/'],
};
const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteOrigin}/#website`,
    url: `${siteOrigin}/`,
    name: siteName,
    alternateName: ['柏狗屁世界 Blog', 'bgpsekai'],
    description: '3C 開箱與敗家心得、程式筆記、巴哈動畫瘋工具與各種踩雷紀錄。',
    publisher: { '@id': `${siteOrigin}/#publisher` },
    inLanguage: 'zh-Hant',
  },
  publisher,
];
if (ogType === 'article' && publishDate) {
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${canonicalUrl}#article`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
    url: canonicalUrl,
    headline: title,
    ...(description ? { description } : {}),
    ...(ogImage ? { image: ogImage } : {}),
    datePublished: publishDate.toISOString(),
    dateModified: (modifiedDate ?? publishDate).toISOString(),
    ...(author
      ? { author: { '@type': 'Person', name: author, url: abs(`/author/${author}/`) } }
      : {}),
    publisher: { '@id': `${siteOrigin}/#publisher` },
    ...(tagNames.length > 0 ? { keywords: tagNames.join(', ') } : {}),
    isPartOf: { '@id': `${siteOrigin}/#website` },
    inLanguage: 'zh-Hant',
  });
}
if (ogType !== 'article') {
  graph.push({
    '@type': pageType ?? 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: title,
    ...(description ? { description } : {}),
    isPartOf: { '@id': `${siteOrigin}/#website` },
    inLanguage: 'zh-Hant',
  });
}
if (breadcrumbs.length > 0) {
  const trail = [{ name: '首頁', path: '/' }, ...breadcrumbs];
  graph.push({
    '@type': 'BreadcrumbList',
    '@id': `${canonicalUrl}#breadcrumb`,
    itemListElement: trail.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: abs(b.path),
    })),
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

// GA4 — only inject when the env var is provided (avoids breaking builds in
// development before the GA property is created). The §9.3 task will switch to
// a hard fail once `PUBLIC_GA4_MEASUREMENT_ID` is wired in CI.
const ga4Id = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID as string | undefined;

// Favicon: real files under public/. Until 2026-11-13 this was a data: URI,
// which browsers accept but Google cannot fetch, so search results showed the
// generic globe. PNGs are rendered from the same puppy emoji.
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <!--
      No-flash theme init: must run synchronously before <body> paints, so we
      keep it as the very first <head> child. Reads localStorage if the user
      already chose, otherwise honours system preference. Sets data-theme on
      <html> which the CSS reads via [data-theme="dark"].
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
            return;
          }
        } catch (e) {
          /* private mode — fall through */
        }
        var prefersDark =
          window.matchMedia &&
          window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute(
          'data-theme',
          prefersDark ? 'dark' : 'light',
        );
      })();
    </script>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta
      name="robots"
      content={noindex
        ? 'noindex,follow'
        : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
    />
    <link rel="canonical" href={canonicalUrl} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <link rel="icon" href={baseUrl('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href={baseUrl('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={baseUrl('/apple-touch-icon.png')} />

    <meta property="og:site_name" content="柏狗屁世界" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content={title} />
    {ogType === 'article' && publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {ogType === 'article' && modifiedDate && (
      <meta property="article:modified_time" content={modifiedDate.toISOString()} />
    )}
    {ogType === 'article' && author && <meta name="author" content={author} />}
    {ogType === 'article' && tagNames.map((t) => <meta property="article:tag" content={t} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={shareImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="柏狗屁世界"
      href={`${siteOrigin}${baseUrl('/rss.xml')}`}
    />

    <!-- AdSense -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9488921689181013"
      crossorigin="anonymous"></script>

    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script is:inline define:vars={{ ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
        </script>
      </>
    )}

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
