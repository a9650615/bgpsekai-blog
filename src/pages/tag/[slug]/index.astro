---
// /tag/<slug>/ — tag index, page 1.
//
// Spec ref: blog-rendering "Tag and author indexes" — render an index per tag
// with at least one post; display name (zh) shown as heading; URL uses Pinyin
// `slug`. Posts ordered by pubDate descending.
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import tagsData from '../../../data/tags.json';
import { url } from '../../../utils/url.ts';
import { MIN_POSTS_FOR_INDEXED_TAG } from '../../../utils/seo.ts';

interface TagRecord {
  slug: string;
  originalSlug: string;
  name: string;
  description?: string;
}

export const getStaticPaths = (async () => {
  const POSTS_PER_PAGE = 10;
  const tags = tagsData as TagRecord[];
  const allPosts = (await getCollection('posts')).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  );
  return tags
    .map((tag) => {
      const posts = allPosts.filter((p) => p.data.tags.includes(tag.slug));
      if (posts.length === 0) return null;
      const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
      return {
        params: { slug: tag.slug },
        props: {
          tag,
          posts: posts.slice(0, POSTS_PER_PAGE),
          postCount: posts.length,
          totalPages,
        },
      };
    })
    .filter((x): x is NonNullable<typeof x> => x !== null);
}) satisfies GetStaticPaths;

const { tag, posts, postCount, totalPages } = Astro.props;
// Name the posts in the description: 88 tags all saying 所有「X」相關文章 gave
// search engines nothing to tell the pages apart.
const tagSummary = `「${tag.name}」的 ${postCount} 篇文章：${posts.slice(0, 3).map((p) => p.data.title).join('、')}${postCount > 3 ? '等' : ''}。`;
---

<BaseLayout
  title={`標籤:${tag.name} - 柏狗屁世界`}
  description={tag.description ?? tagSummary}
  canonicalPath={`/tag/${tag.slug}/`}
  noindex={postCount < MIN_POSTS_FOR_INDEXED_TAG}
  pageType="CollectionPage"
  breadcrumbs={[{ name: `標籤：${tag.name}`, path: `/tag/${tag.slug}/` }]}
  ogType="website"
>
  <Hero
    title={tag.name}
    description={tag.description ?? `所有「${tag.name}」相關文章。`}
    showCta={false}
  />

  <div class="l-wrap">
    <h2 class="section-title">文章列表</h2>
    <section class="post-grid">
      {posts.map((p) => <PostCard entry={p} />)}
    </section>
    <Pagination currentPage={1} totalPages={totalPages} basePath={url(`/tag/${tag.slug}/`)} />
  </div>
</BaseLayout>
