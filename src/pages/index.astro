---
// Home — paginated post listing, page 1 (latest 10 posts).
//
// Spec ref: blog-rendering "Paginated home". Page 1 is served at `/`; pages
// 2..N are owned by `src/pages/page/[page].astro`.
//
// Implementation: rather than `paginate()` (which would also try to emit
// /page/1/ as an alias), we hand-slice the first 10 posts here so the URL
// space stays clean. The latest post's featureImage is used as the Hero
// background; the grid below renders all 10 posts.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { url } from '../utils/url.ts';

const POSTS_PER_PAGE = 10;

const all = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const totalPages = Math.max(1, Math.ceil(all.length / POSTS_PER_PAGE));
const posts = all.slice(0, POSTS_PER_PAGE);
const heroCover = posts[0]?.data.featureImage;
---

<BaseLayout
  title="柏狗屁世界 Blog — 開箱、程式筆記與踩雷紀錄"
  description="柏狗屁世界的 blog：3C 開箱與敗家心得、前端與 Node.js 程式筆記、巴哈動畫瘋小工具，還有各種踩雷紀錄。"
  pageType="Blog"
  canonicalPath="/"
  ogType="website"
>
  <Hero cover={typeof heroCover !== 'string' ? heroCover : undefined} bigger />

  <div class="l-wrap" id="latest">
    <h2 class="section-title">最新文章</h2>
    <section class="post-grid">
      {posts.map((post) => <PostCard entry={post} />)}
    </section>
    <Pagination currentPage={1} totalPages={totalPages} basePath={url('/')} />
  </div>
</BaseLayout>
