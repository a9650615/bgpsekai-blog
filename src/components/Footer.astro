---
// Site footer. Marked `data-pagefind-ignore` so the copyright + RSS link don't
// pollute search snippets.
import { url } from '../utils/url.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer__inner">
    <p class="site-footer__copy">
      © 2014–{year} 柏狗屁世界
    </p>
    <nav class="site-footer__links" aria-label="footer">
      {/* Sister sites. Search engines only learn these belong together (and
          find the brainrot site at all) through links like these. */}
      <a href={url('/archive/')}>所有文章</a>
      <a href={url('/about-me/')}>關於我</a>
      <a href="https://bgpsekai.club/">入口站</a>
      <a href="https://danmu.bgpsekai.club/">腦腐現場</a>
      <a href={url('/rss.xml')} type="application/rss+xml">RSS</a>
    </nav>
  </div>
</footer>
