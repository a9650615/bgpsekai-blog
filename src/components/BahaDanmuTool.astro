---
// Baha 彈幕 → ASS 工具 UI shell.
// This is a static fragment; behaviour is provided by the colocated client
// script `BahaDanmuTool.client.ts`, loaded as an ES module script tag.
import {
  BRAINROT_HOME_URL,
  BRAINROT_PROMO_COPY,
} from '../lib/baha-danmu/brainrot';
---

<section class="baha-danmu-tool" data-baha-danmu-tool aria-label="巴哈彈幕轉 ASS 工具">
  <p class="baha-danmu-tool__hint">
    將動漫瘋影片頁網址 (含 <code>sn=</code>) 或純 SN 數字貼到下方輸入框,按「取得」即可下載 ASS 字幕。
    範例: <code>https://ani.gamer.com.tw/animeVideo.php?sn=15577</code>
  </p>

  <aside class="baha-danmu-tool__promo" aria-labelledby="baha-brainrot-promo-title">
    <div>
      <p class="baha-danmu-tool__promo-kicker">{BRAINROT_PROMO_COPY.kicker}</p>
      <h2 id="baha-brainrot-promo-title">想看彈幕，但不想被劇透？</h2>
      <p>{BRAINROT_PROMO_COPY.description}</p>
    </div>
    <a
      class="baha-danmu-tool__promo-link"
      href={BRAINROT_HOME_URL}
      target="_blank"
      rel="noopener noreferrer"
    >{BRAINROT_PROMO_COPY.link}</a>
  </aside>

  <form class="baha-danmu-tool__form" onsubmit="return false;">
    <label class="baha-danmu-tool__field">
      <span>網址或 SN</span>
      <input
        id="baha-param"
        name="param"
        type="text"
        placeholder="請輸入網站網址或者 sn ID"
        autocomplete="off"
        spellcheck="false"
      />
      <a
        id="baha-brainrot-sn"
        class="baha-danmu-tool__sn-link"
        target="_blank"
        rel="noopener noreferrer"
        hidden
      ></a>
    </label>

    <label class="baha-danmu-tool__field baha-danmu-tool__field--narrow">
      <span>時間差 (秒)</span>
      <input id="baha-offset" name="offset" type="number" value="0" step="1" />
    </label>

    <button id="baha-get" type="button" class="baha-danmu-tool__submit">取得</button>
  </form>

  <p class="baha-danmu-tool__progress">
    <span>進度狀態:</span>
    <span id="baha-status" data-status="idle"></span>
  </p>

  <p id="baha-error" class="baha-danmu-tool__error" role="alert" hidden></p>

  <p class="baha-danmu-tool__download-row">
    <a id="baha-download" class="baha-danmu-tool__download" hidden>下載 ASS</a>
  </p>

</section>

<script>
  // Hydrate the tool. Astro's bundler will compile and inject this for us.
  import '../components/BahaDanmuTool.client.ts';
</script>

<style>
  .baha-danmu-tool {
    width: min(100%, 1008px);
    max-width: 1008px;
    margin: 2rem auto;
    padding: 1.5rem 1rem;
    line-height: 1.6;
    overflow-x: clip;
  }

  .baha-danmu-tool__hint {
    color: var(--primary-foreground-color);
    font-size: 0.95rem;
    margin: 0 0 1.25rem;
  }
  .baha-danmu-tool__hint code {
    background: var(--secondary-subtle-color);
    color: var(--link-color);
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.85em;
  }

  .baha-danmu-tool__promo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 1rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--primary-border-color);
    border-left: 4px solid var(--primary-subtle-color);
    border-radius: var(--radius, 8px);
    background: var(--background-color);
  }
  .baha-danmu-tool__promo > div {
    min-width: 0;
    flex: 1 1 auto;
  }
  .baha-danmu-tool__promo p,
  .baha-danmu-tool__promo h2 { margin: 0; }
  .baha-danmu-tool__promo-kicker {
    color: var(--primary-subtle-color);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .baha-danmu-tool__promo h2 {
    margin-top: 0.15rem;
    font-size: 1.1rem;
  }
  .baha-danmu-tool__promo p:last-child {
    margin-top: 0.25rem;
    color: var(--primary-foreground-color);
    font-size: 0.9rem;
  }
  .baha-danmu-tool__promo-link,
  .baha-danmu-tool__sn-link {
    color: var(--link-color);
    font-weight: 700;
    text-decoration: none;
  }
  .baha-danmu-tool__promo-link {
    flex: 0 0 auto;
    white-space: nowrap;
  }
  .baha-danmu-tool__promo-link:hover,
  .baha-danmu-tool__sn-link:hover { text-decoration: underline; }

  .baha-danmu-tool__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8.75rem auto;
    gap: 0.75rem;
    align-items: start;
    margin-bottom: 1rem;
    padding: 1.25rem;
    background: var(--secondary-subtle-color);
    border: 1px solid var(--secondary-border-color);
    border-radius: var(--radius, 8px);
  }
  .baha-danmu-tool__field {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .baha-danmu-tool__field span {
    font-size: 0.85rem;
    color: var(--primary-foreground-color);
    font-weight: 600;
    margin-bottom: 0.35rem;
  }
  .baha-danmu-tool__field input {
    min-width: 0;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--primary-border-color);
    border-radius: var(--radius, 8px);
    font-size: 1rem;
    box-sizing: border-box;
    width: 100%;
    background: var(--background-color);
    color: var(--secondary-foreground-color);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .baha-danmu-tool__field input:focus {
    outline: none;
    border-color: var(--primary-subtle-color);
    box-shadow: 0 0 0 3px rgba(4, 174, 238, 0.18);
  }
  .baha-danmu-tool__sn-link {
    display: block;
    max-width: 100%;
    margin-top: 0.4rem;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .baha-danmu-tool__submit {
    padding: 0.6rem 1.5rem;
    background: var(--primary-subtle-color);
    color: #fff;
    border: none;
    border-radius: var(--radius, 8px);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 1.7rem;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .baha-danmu-tool__submit:hover:not(:disabled) {
    background: var(--link-color);
    transform: translateY(-1px);
  }
  .baha-danmu-tool__submit:disabled {
    background: var(--primary-border-color);
    cursor: not-allowed;
  }

  .baha-danmu-tool__progress {
    margin: 0.75rem 0;
    color: var(--primary-foreground-color);
  }
  #baha-status[data-status='error'] { color: #b00020; font-weight: bold; }
  #baha-status[data-status='done']  { color: #1b6e1b; font-weight: bold; }

  .baha-danmu-tool__error {
    margin: 0.5rem 0;
    padding: 0.6rem 0.8rem;
    border-left: 4px solid #b00020;
    background: #fbeaea;
    color: #690012;
    border-radius: 0 var(--radius, 8px) var(--radius, 8px) 0;
  }

  .baha-danmu-tool__download-row { margin: 1rem 0; }
  .baha-danmu-tool__download {
    display: inline-block;
    padding: 0.55rem 1.2rem;
    background: #1b6e1b;
    color: #fff;
    text-decoration: none;
    border-radius: var(--radius, 8px);
    font-weight: 600;
    transition: background 0.15s ease;
  }
  .baha-danmu-tool__download:hover { background: #258025; }

  @media (max-width: 760px) {
    .baha-danmu-tool { padding: 1rem 0.75rem; }
    .baha-danmu-tool__promo {
      align-items: flex-start;
      flex-direction: column;
    }
    .baha-danmu-tool__promo-link { white-space: normal; }
    .baha-danmu-tool__form {
      grid-template-columns: 1fr;
    }
    .baha-danmu-tool__submit {
      width: 100%;
      margin-top: 0;
    }
  }

</style>
